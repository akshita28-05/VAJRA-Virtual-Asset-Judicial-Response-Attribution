# VAJRA Console - environment configuration
# Copy this file to .env and fill in what you need. VAJRA_LIVE_MODE
# defaults to off, which is the zero-internet blockchain-data path
# documented in README.md. Set values below only when you want real,
# live blockchain data instead of the seeded offline fixtures.

# ---------------------------------------------------------------------
# Database. Set to a Postgres URL to run against real Postgres (this is
# what `docker-compose up` sets automatically - see docker-compose.yml).
# Leave unset to fall back to a local SQLite file at backend/vajra.db,
# which is what the test suite always uses regardless of this setting.
DATABASE_URL=postgresql://vajra:vajra_demo_password@localhost:5432/vajra

# ---------------------------------------------------------------------
# Master switch. "1" = try live provider APIs first (falling back to
# offline fixtures automatically if every configured provider fails).
# Anything else, or unset = always use offline fixtures.
VAJRA_LIVE_MODE=0

# ---------------------------------------------------------------------
# Auth (backend/auth.py). Change this in any real deployment - the
# default is a published, insecure dev value.
VAJRA_JWT_SECRET=vajra-dev-secret-change-in-production-9f21a

# ---------------------------------------------------------------------
# Ethereum - Etherscan (primary), free tier: https://etherscan.io/apis
# Blockscout (automatic fallback) needs no key.
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------------
# Tron - TronGrid (primary), free key: https://www.trongrid.io
# TronScan (automatic fallback) needs no key.
TRONGRID_API_KEY=

# ---------------------------------------------------------------------
# Bitcoin - Blockstream + mempool.space, both public, no key required.
# Nothing to set here; listed for completeness.

# ---------------------------------------------------------------------
# Optional: real Redis cache for live API responses (engine/cache.py).
# Leave unset to use the built-in in-memory TTL cache - same interface,
# no code changes needed either way.
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# HTTP client tuning for live adapters (engine/chain_adapters.py).
VAJRA_API_TIMEOUT=8
VAJRA_API_MAX_RETRIES=3
VAJRA_LIVE_CACHE_TTL=120

# ---------------------------------------------------------------------
# Deployment mode. "production" enforces a real VAJRA_JWT_SECRET (boot
# refuses the default dev value) and is what the Dockerfile sets.
# Leave unset ("development") for local/demo runs.
VAJRA_ENV=development

# CORS - comma-free single origin the console is served from in a real
# deployment (e.g. https://vajra.yourdomain.gov.in). "*" (default) is
# fine for the demo but should be pinned before any real exposure.
VAJRA_ALLOWED_ORIGIN=*

# Override the SQLite file location (ignored when DATABASE_URL/Postgres
# is set). Useful for mounting a persistent volume in a container.
# Leave unset to use backend/vajra.db.
# VAJRA_DB_PATH=

# Postgres connection-pool ceiling (only relevant when DATABASE_URL is
# set). Defaults to 10 if unset.
VAJRA_DB_POOL_MAX=10

# ---------------------------------------------------------------------
# Not yet wired to any code path in this build - listed here as the
# documented next-step keys per docs/BUILT_VS_ROADMAP.md, so the
# provider trail is in one place instead of scattered across chat
# history:
# ALCHEMY_API_KEY=
# INFURA_API_KEY=
# BLOCKCHAIR_API_KEY=
# ANKR_API_KEY=
# COINGECKO_API_KEY=
